<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_agent</name>
  <version>0.1.0</version>
  <description>
    robot_agent: natural-language task -&gt; LLM -&gt; structured action -&gt;
    Ros2RobotTool. Provider-agnostic BaseLLM (mock default, DeepSeek/OpenAI
    compatible), extensible for VLM / voice in later milestones.
  </description>
  <maintainer email="jxql-airobot@users.noreply.github.com">jxql-airobot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>robot_tools</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
