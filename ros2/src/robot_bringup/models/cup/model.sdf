      <pose>0 0 0.15 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.02 0.3 0.3</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.02 0.3 0.3</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://cup/materials/scripts</uri>
            <uri>model://cup/materials/textures</uri>
            <name>Cup/Diffuse</name>
          </script>
        </material>
